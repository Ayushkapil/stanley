<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Stanley</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>32</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Stanley uses the camera to take your photo for the day.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>When you turn on the lock, Stanley uses biometric authentication so only you can open it.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Stanley fills in where a photo was taken and shows headlines from the town you're in. Stanley only ever sends the name of a place, never where you are exactly, and you can change or clear it before posting.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Stanley saves a photo to your library only when it couldn't be posted, so it isn't lost. Photos you choose to post come through Apple's photo picker, which needs no access to your library.</string>
	<key>STANLEY_API_BASE</key>
	<string>$(STANLEY_API_BASE)</string>
	<key>STANLEY_SENTRY_DSN</key>
	<string></string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
